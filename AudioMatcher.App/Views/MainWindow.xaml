<Window x:Class="AudioMatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioMatcher.App.Controls"
        Title="Audio Segment Matcher &amp; Cutter"
        Height="920" Width="1280"
        MinHeight="720" MinWidth="960"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Locate FFmpeg" Command="{Binding LocateFfmpegCommand}" Margin="12,0,0,0"/>
            <TextBlock Text="Audio Segment Matcher &amp; Cutter" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" Text="{Binding FfmpegStatus}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFfmpeg}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource LinkButton}"
                            Content="{Binding FailedCountText}"
                            Command="{Binding OpenLogsCommand}"
                            ToolTip="Open the logs folder"
                            Visibility="{Binding HasFailedResults, Converter={StaticResource VisibleWhenTrue}}"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
                <ProgressBar Grid.Row="1" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Source Audio" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding SourceFilePath, TargetNullValue=No file selected}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Select File" Command="{Binding BrowseSourceCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:WaveformControl x:Name="Waveform"
                                              Waveform="{Binding Waveform}"
                                              Duration="{Binding Duration}"
                                              Position="{Binding Position}"
                                              SampleStart="{Binding SampleStart, Mode=TwoWay}"
                                              SampleEnd="{Binding SampleEnd, Mode=TwoWay}"
                                              SeekRequested="OnSeekRequested"
                                              SelectionChanged="OnSelectionChanged"
                                              ViewportChanged="OnWaveformViewportChanged"/>
                    <ScrollBar x:Name="WaveformScroll"
                               Grid.Row="1"
                               Orientation="Horizontal"
                               Height="14"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               Minimum="0"
                               SmallChange="1"
                               LargeChange="5"
                               Scroll="OnWaveformScroll"
                               ValueChanged="OnWaveformScrollValueChanged"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Start"/>
                                <TextBox Grid.Column="1" Text="{Binding SampleStartText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                                <Label Grid.Column="2" Content="End"/>
                                <TextBox Grid.Column="3" Text="{Binding SampleEndText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                                <Label Grid.Column="4" Content="Duration"/>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SampleDurationText}"/>
                                    <TextBlock Text="{Binding PositionText}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding SampleWarning}" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding HasSampleWarning, Converter={StaticResource VisibleWhenTrue}}"/>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="Play / Pause" Command="{Binding PlayPauseCommand}" Style="{StaticResource AccentButton}"/>
                                <Button Content="Stop" Command="{Binding StopPlaybackCommand}"/>
                                <Button Content="Set Start" Command="{Binding SetStartFromPlayheadCommand}"/>
                                <Button Content="Set End" Command="{Binding SetEndFromPlayheadCommand}"/>
                                <Button Content="Clear" Command="{Binding ClearSampleCommand}"/>
                                <Button Content="Zoom In" Click="OnZoomIn"/>
                                <Button Content="Zoom Out" Click="OnZoomOut"/>
                                <Button Content="Fit" Click="OnFit"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Results" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="{Binding ResultSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"/>
                            </DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="Select All" Command="{Binding SelectAllCommand}"/>
                                <Button Content="Select Matched" Command="{Binding SelectMatchedCommand}"/>
                                <Button Content="Clear Selection" Command="{Binding ClearSelectionCommand}"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Results}" IsReadOnly="False" CanUserResizeRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Match" Binding="{Binding MatchText}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Search Folder" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSearchFolderCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <CheckBox Content="Include Subfolders" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}"/>
                                <Button Content="Cancel" Command="{Binding CancelSearchCommand}" Style="{StaticResource DangerButton}"
                                        Visibility="{Binding IsSearching, Converter={StaticResource VisibleWhenTrue}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SearchDisabledReason}" Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"
                                       Visibility="{Binding HasSearchDisabledReason, Converter={StaticResource VisibleWhenTrue}}"/>

                            <TextBlock Text="Action" Style="{StaticResource SectionTitle}"/>
                            <RadioButton Content="Remove All Matches" IsChecked="{Binding IsRemoveAll}" GroupName="Action"/>
                            <RadioButton Content="Cut Before First Match" IsChecked="{Binding IsCutBefore}" GroupName="Action" Margin="0,8,0,0"/>
                            <RadioButton Content="Cut After First Match" IsChecked="{Binding IsCutAfter}" GroupName="Action" Margin="0,8,0,16"/>

                            <TextBlock Text="Output Folder" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseOutputFolderCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Existing output files are skipped. Original files are never modified." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Process Selected" Command="{Binding ProcessSelectedCommand}" Style="{StaticResource AccentButton}"/>
                                <Button Content="Cancel" Command="{Binding CancelProcessCommand}" Style="{StaticResource DangerButton}"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource VisibleWhenTrue}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
