<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Audio Segment Matcher &amp; Cutter</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\tools\ffmpeg\*.exe" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\ffmpeg')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioMatcher.Core\AudioMatcher.Core.csproj" />
    <ProjectReference Include="..\AudioMatcher.Infrastructure\AudioMatcher.Infrastructure.csproj" />
  </ItemGroup>

</Project>
