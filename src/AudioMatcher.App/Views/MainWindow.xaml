<Window x:Class="AudioMatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioMatcher.App.Controls"
        Title="{DynamicResource AppTitle}"
        Height="920" Width="1280"
        MinHeight="720" MinWidth="960"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{DynamicResource LocateFfmpeg}" Command="{Binding LocateFfmpegCommand}" Margin="12,0,0,0"/>
            <Button DockPanel.Dock="Right"
                    Command="{Binding ToggleLanguageCommand}"
                    Margin="12,0,0,0"
                    Padding="8,4"
                    ToolTip="{DynamicResource SwitchLanguageToolTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="中文">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Opacity" Value="0.55"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChinese}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text=" | " Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="English">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Opacity" Value="0.55"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChinese}" Value="False">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            <TextBlock Text="{DynamicResource AppTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" Text="{Binding FfmpegStatus}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFfmpeg}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource LinkButton}"
                            Content="{Binding FailedCountText}"
                            Command="{Binding OpenLogsCommand}"
                            ToolTip="{DynamicResource OpenLogsToolTip}"
                            Visibility="{Binding HasFailedResults, Converter={StaticResource VisibleWhenTrue}}"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
                <ProgressBar Grid.Row="1" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SourceAudio}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="{Binding SourceFilePath}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SourceFilePath}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{DynamicResource NoFileSelected}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource SelectFile}" Command="{Binding BrowseSourceCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:WaveformControl x:Name="Waveform"
                                              Waveform="{Binding Waveform}"
                                              Duration="{Binding Duration}"
                                              Position="{Binding Position}"
                                              SampleStart="{Binding SampleStart, Mode=TwoWay}"
                                              SampleEnd="{Binding SampleEnd, Mode=TwoWay}"
                                              SeekRequested="OnSeekRequested"
                                              SelectionChanged="OnSelectionChanged"
                                              ViewportChanged="OnWaveformViewportChanged"/>
                    <ScrollBar x:Name="WaveformScroll"
                               Grid.Row="1"
                               Orientation="Horizontal"
                               Height="14"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               Minimum="0"
                               SmallChange="1"
                               LargeChange="5"
                               Scroll="OnWaveformScroll"
                               ValueChanged="OnWaveformScrollValueChanged"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Start}"/>
                                <TextBox Grid.Column="1" Text="{Binding SampleStartText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                                <Label Grid.Column="2" Content="{DynamicResource End}"/>
                                <TextBox Grid.Column="3" Text="{Binding SampleEndText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                                <Label Grid.Column="4" Content="{DynamicResource Duration}"/>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SampleDurationText}"/>
                                    <TextBlock Text="{Binding PositionText}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding SampleWarning}" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding HasSampleWarning, Converter={StaticResource VisibleWhenTrue}}"/>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="{DynamicResource PlayPause}" Command="{Binding PlayPauseCommand}" Style="{StaticResource AccentButton}"/>
                                <Button Content="{DynamicResource Stop}" Command="{Binding StopPlaybackCommand}"/>
                                <Button Content="{DynamicResource SetStart}" Command="{Binding SetStartFromPlayheadCommand}"/>
                                <Button Content="{DynamicResource SetEnd}" Command="{Binding SetEndFromPlayheadCommand}"/>
                                <Button Content="{DynamicResource Clear}" Command="{Binding ClearSampleCommand}"/>
                                <Button Content="{DynamicResource ZoomIn}" Click="OnZoomIn"/>
                                <Button Content="{DynamicResource ZoomOut}" Click="OnZoomOut"/>
                                <Button Content="{DynamicResource Fit}" Click="OnFit"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Results}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="{Binding ResultSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"/>
                            </DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="{DynamicResource SelectAll}" Command="{Binding SelectAllCommand}"/>
                                <Button Content="{DynamicResource SelectMatched}" Command="{Binding SelectMatchedCommand}"/>
                                <Button Content="{DynamicResource ClearSelection}" Command="{Binding ClearSelectionCommand}"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Results}" IsReadOnly="False" CanUserResizeRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                                    <DataGridTextColumn Binding="{Binding FileName}" Width="2*" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource ColumnFile}" Foreground="{StaticResource MutedTextBrush}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding DurationText}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource ColumnDuration}" Foreground="{StaticResource MutedTextBrush}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding MatchText}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource ColumnMatch}" Foreground="{StaticResource MutedTextBrush}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding ConfidenceText}" Width="100" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource ColumnConfidence}" Foreground="{StaticResource MutedTextBrush}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding StatusText}" Width="140" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource ColumnStatus}" Foreground="{StaticResource MutedTextBrush}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SearchFolder}" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="{DynamicResource Browse}" Command="{Binding BrowseSearchFolderCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <CheckBox Content="{DynamicResource IncludeSubfolders}" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="{DynamicResource Search}" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}"/>
                                <Button Content="{DynamicResource Cancel}" Command="{Binding CancelSearchCommand}" Style="{StaticResource DangerButton}"
                                        Visibility="{Binding IsSearching, Converter={StaticResource VisibleWhenTrue}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SearchDisabledReason}" Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"
                                       Visibility="{Binding HasSearchDisabledReason, Converter={StaticResource VisibleWhenTrue}}"/>

                            <TextBlock Text="{DynamicResource Action}" Style="{StaticResource SectionTitle}"/>
                            <RadioButton IsChecked="{Binding IsRemoveAll}" GroupName="Action">
                                <TextBlock Text="{DynamicResource RemoveAllMatches}" TextWrapping="Wrap"/>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding IsCutBefore}" GroupName="Action" Margin="0,8,0,0"
                                         ToolTip="{DynamicResource CutBeforeToolTip}">
                                <TextBlock Text="{DynamicResource CutBeforeFirstMatch}" TextWrapping="Wrap"/>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding IsCutAfter}" GroupName="Action" Margin="0,8,0,16"
                                         ToolTip="{DynamicResource CutAfterToolTip}">
                                <TextBlock Text="{DynamicResource CutAfterFirstMatch}" TextWrapping="Wrap"/>
                            </RadioButton>

                            <TextBlock Text="{DynamicResource OutputFolder}" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="{DynamicResource Browse}" Command="{Binding BrowseOutputFolderCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource OutputHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource ProcessSelected}" Command="{Binding ProcessSelectedCommand}" Style="{StaticResource AccentButton}"/>
                                <Button Content="{DynamicResource Cancel}" Command="{Binding CancelProcessCommand}" Style="{StaticResource DangerButton}"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource VisibleWhenTrue}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
